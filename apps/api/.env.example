# Copy to .env. All values below are local-only defaults matching docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://studycubby:studycubby@localhost:5433/studycubby_dev"
TEST_DATABASE_URL="postgresql://studycubby:studycubby@localhost:5433/studycubby_test"

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:443,http://localhost:5173"

# Where uploaded/seeded media is written (relative to apps/api).
STORAGE_DIR="./storage"

# Dev auth: requests without an X-Dev-User header act as this user. Leave empty for anonymous.
DEV_DEFAULT_USER=""

# Seed media folder (relative to apps/api). Must contain the folders named in fixtures/manifest.json.
SEED_MEDIA_DIR="./fixtures/media"
