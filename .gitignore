# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment & secrets (templates are allowed)
.env
.env.*
!.env.example
!.env.reference
.aws/

# Uploaded media — never commit audio
library/
uploads/
*.mp3
*.wav
*.flac
*.m4a

# Deploy tooling
.netlify/

# Python leftovers
venv/
__pycache__/
.pytest_cache/

# Logs
logs/
*.log
npm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# API dev data (seed media, local storage, generated Prisma client)
apps/api/fixtures/media/
apps/api/storage/
apps/api/src/generated/
# Real seed manifest names your own music; commit only the template (manifest.example.json)
apps/api/fixtures/manifest.json
